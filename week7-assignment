import requests
url = "https://random.dog/woof.json"
def main():
    print("Welcome to Random Dog Viewer")
    count = int(input("Enter the number of dogs you need: "))
    if count <= 0:
        print("Number must be positive.")
        return 
    print("Getting dog images...")
    for _ in range(count):
        try:
            response = requests.get(url) 
            if response.status_code == 200:
                data = response.json()
                print("Dog image:", data["url"])
            else:
                print(f"API error:{response.status_code}")
        except:
            print("Internet connection or network error!")
main()










