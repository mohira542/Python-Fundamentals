def create_book_catalog(borrowed_books):
    catalog = {}
    for book in borrowed_books:
        isbn = book[0]
        title = book[1]
        catalog[isbn] = title
    return catalog

def audit_returns(catalog, returned_isbns):
    catalog_isbns = set(catalog.keys())
    returned_isbns = set(returned_isbns)
    overdue_books = catalog_isbns - returned_isbns
    unknown_returns = returned_isbns - catalog_isbns
    return overdue_books, unknown_returns

def format_overdue_report(catalog, overdue_isbns):    
    report = [
        "MISSING: " + catalog[isbn] + " (ISBN: " + str(isbn) + ")"
        for isbn in overdue_isbns 
    ]
    report.sort()
    return report
        
borrowed = [
    (1001, "The Great Gatsby", "John"),
    (1002, "1984", "Sarah"),
    (1003, "Python 101", "Mike")
]

returned = [1003, 1001, 9999]
catalog = create_book_catalog(borrowed)
overdue, unknown = audit_returns(catalog, returned)
report = format_overdue_report(catalog, overdue)
print("Overdue ISBNs:", overdue)
print("Unknown Returns:", unknown)
print("Report:", report)



























