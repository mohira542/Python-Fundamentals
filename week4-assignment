def group_packages(shipment_list):
    shipping_dict = {}
    for item in shipment_list:
        city, box_id, weight = item.split("|")
        weight = int(weight)
        if city not in shipping_dict:
            shipping_dict[city] = []
        shipping_dict[city].append((box_id, weight))
    return shipping_dict

def calculate_truck_loads(shipping_dict):
    for city, packages in shipping_dict.items():
        total_weight = 0
        for package_id, weight in packages:
            total_weight += weight
        print(f"{city}: {total_weight} kg total")

shipment_list = [
    "New York|Box101|50",
    "Chicago|Box102|20",
    "New York|Box103|30",
    "Miami|Box104|15",
    "Chicago|Box105|45",
    "New York|Box106|10"
]

shipping_dict = group_packages(shipment_list)
calculate_truck_loads(shipping_dict)
