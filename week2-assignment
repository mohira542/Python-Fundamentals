


player_stats = [
    ('LeBron', 'Lakers', [30, 25, 35]),
    ('Curry', 'Warriors', [32, 28, 27]),
    ('Davis', 'Lakers', [22, 26, 20]),
    ('Tatum', 'Celtics', [28, 29, 31])
]

def calculate_ppg(points):
    if len(points) == 0:
        return 0.0
    total = 0
    for p in points:
        total += p
    return total / len(points)

def find_mvp(player_stats):
    player_stats.sort() 
    best_ppg = -1
    best_player = ""
    for player, team, points in player_stats:
        avg = calculate_ppg(points)
        if avg > best_ppg:
            best_ppg = avg
            best_player = player
        elif avg == best_ppg:
            
            if player < best_player:
                best_player = player
    return best_player

def get_players_from_team(stats, team_name):
    players = []
    for player, team, points in stats:
        if team == team_name:
            players.append(player)
    players.sort()
    return players

def get_team_scoring_summary(player_stats):
    summary = [] 
    for name, team, scores in player_stats:
        total_points = sum(scores)
        found = False
        for i in range(len(summary)):
            if summary[i][0] == team:
                summary[i] = (team, summary[i][1] + total_points)
                found = True
                break
        if not found:
            summary.append((team, total_points))
    for i in range(len(summary)):
        for j in range(i + 1, len(summary)):
            if summary[i][0] > summary[j][0]:  # compare team names
                summary[i], summary[j] = summary[j], summary[i]
    return summary

def analyze_player_stats(player_stats):
    mvp = find_mvp(player_stats)
    lakers_players = get_players_from_team(player_stats, 'Lakers')
    team_summary = get_team_scoring_summary(player_stats)
    
    return (mvp, lakers_players, team_summary)

result = analyze_player_stats(player_stats)
